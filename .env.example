# =============================================================================
# Jarvis smart-home system — configuration
# =============================================================================
# Copy to `.env` in the repository root. systemd units load it with
# EnvironmentFile=, the entry points with python-dotenv.
#
# Tuned values (thresholds, timeouts, engines) are the ones the live Raspberry
# Pi runs with. `replace-me` marks secrets; `e.g.` marks illustrative values.
# Anything not listed here has a sensible default in code.
#
# No inline comments: systemd's EnvironmentFile= would keep them as part of
# the value. Comments go on their own line.
#
# Trap worth knowing: with duplicate keys the LAST occurrence wins. A stale
# line further down silently overrides an edit higher up.
# =============================================================================

# --- Deployment profile ------------------------------------------------------
# rpi-home: wake word on, API token required, curated agent set, telemetry off.
DEPLOYMENT_PROFILE=rpi-home
# bearer token for /api/*; long and random
API_TOKEN=replace-me
# Home Assistant must reach the API
WEB_HOST=0.0.0.0
WEB_PORT=8000

# --- Language models ---------------------------------------------------------
# The brain is Claude (via LiteLLM); retrieval agents stay on Gemini/Vertex.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=replace-me
CLAUDE_PRO_MODEL=claude-sonnet-5
CLAUDE_FLASH_MODEL=claude-sonnet-5
CLAUDE_LITE_MODEL=claude-sonnet-5
# Per-agent override, e.g. synthesizer=claude-opus-5,researcher=claude-sonnet-5
CLAUDE_AGENT_MODELS=
# Agents that must stay on Gemini (socrates and christian_guide always do).
CLAUDE_GEMINI_ONLY_AGENTS=scraper
CLAUDE_PROMPT_CACHE=true
CLAUDE_CACHE_CONVERSATION=true
# Gemini tiers (used by Gemini-pinned agents and as the fallback provider).
FLASH_MODEL=gemini-2.5-flash
PRO_MODEL=gemini-2.5-pro
# Hard daily ceiling on estimated LLM spend, in USD. 0 disables.
# e.g.
DAILY_LLM_BUDGET_USD=5

# --- Google Cloud / Vertex AI -------------------------------------------------
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=replace-me
GOOGLE_CLOUD_LOCATION=global
# region of the RAG corpora
VERTEX_AI_LOCATION=us-west1
GOOGLE_APPLICATION_CREDENTIALS=./secrets/service-account.json
# Developer API key with AI Studio credit — needed by Gemini Transcribe (STT),
# which is not served on Vertex. A different billing pot from Cloud Billing.
GEMINI_API_KEY=replace-me
# Vertex AI RAG corpora for the two knowledge agents.
PHILOSOPHY_CORPUS_ID=
CHRISTIAN_CORPUS_ID=

# --- Google Workspace (OAuth, acts as the household account) -----------------
GOOGLE_OAUTH_CLIENT_ID=replace-me
GOOGLE_OAUTH_CLIENT_SECRET=replace-me
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8080/oauth2callback
# Re-authorise with: python tools/oauth_cli.py --auth   (or --manual from a phone)
REQUIRE_OAUTH_HEALTHCHECK=false
# Signature appended to every email the mailer writes. \n for line breaks.
EMAIL_SIGNATURE=Lijep pozdrav,\nJarvis

# --- Persistence -------------------------------------------------------------
# ADK sessions in memory on the Pi
USE_PERSISTENT_ADK_SESSIONS=false
SESSION_STORAGE=memory

# --- Voice: speech to text ---------------------------------------------------
# gemini_transcribe: best measured Croatian (13.1 % WER vs 18.9 % for Chirp 2).
STT_ENGINE=gemini_transcribe
GEMINI_TRANSCRIBE_MODE=smart
GEMINI_TRANSCRIBE_LANGUAGES=hr-HR
# Household words the recogniser should know (rooms, devices, names).
# e.g.
GEMINI_TRANSCRIBE_VOCABULARY=Jarvis,kupaona,blagovaona,bojler
STT_FALLBACK_ENGINE=chirp
STT_CLOUD_MODEL=chirp_2
STT_CLOUD_LOCATION=us-central1
STT_LANGUAGE_CODE=hr-HR

# --- Voice: text to speech ---------------------------------------------------
TTS_ENGINE=openai
OPENAI_API_KEY=replace-me
OPENAI_TTS_VOICE=cedar
# Cloud TTS voice used automatically when OpenAI fails.
TTS_FALLBACK_VOICE=hr-HR-Chirp3-HD-Charon

# --- Voice: assistant behaviour ----------------------------------------------
VOICE_ASSISTANT_NAME=Jarvis
VOICE_DIRECT_ROUTING=true
# "U redu." only for a verified change
VOICE_SMART_HOME_RESPONSE_MODE=ok
VOICE_AGENT_TIMEOUT_SECONDS=420
# Assist: past this, answer arrives as a notification
VOICE_DEFER_AFTER_SECONDS=25
VOICE_FOLLOW_UP_MODE=true
VOICE_FOLLOW_UP_MAX_TURNS=4
VOICE_WAKE_PROMPT_TEXT="Slušam."
VOICE_FOLLOW_UP_PROMPT_TEXT="Treba li još nešto?"
VOICE_LISTEN_ON_TEXT="Reci?"
VOICE_WEATHER_DEFAULT_LOCATION=Zagreb
USE_PLAN_EXECUTE=true

# --- Wake word (Pi microphone) -----------------------------------------------
WAKEWORD_ENGINE=openwakeword
WAKEWORD_MODEL=hey_jarvis
# Measured: natural "hej jarvis" scores 0.3-0.8. VAD gating at 0.5 made the Pi
# deaf to a quiet speaker, so it is off; the STT-side noise gate catches junk.
WAKEWORD_THRESHOLD=0.32
WAKEWORD_MIN_CONSECUTIVE_FRAMES=1
WAKEWORD_VAD_THRESHOLD=0
WAKEWORD_INPUT_DEVICE=0
# raw wm8960 device rejects 24 kHz
WAKEWORD_OUTPUT_DEVICE=default
WAKEWORD_API_BASE_URL=http://127.0.0.1:8000
WAKEWORD_USER_ID=rpi-voice
# mic is opt-in via the HA switch
WAKEWORD_LISTEN_ON_START=false
WAKEWORD_AUTO_OFF_MINUTES=30

# --- Home Assistant ----------------------------------------------------------
HA_URL=http://homeassistant.local:8123
# long-lived access token
HA_TOKEN=replace-me
HA_NOTIFY_SERVICE=notify.mobile_app_phone
# or "speak" (companion app reads it aloud)
LATE_ANSWER_MODE=notify
# Assist pipeline opened by the dashboard's "Pitaj Jarvisa" buttons.
HA_ASSIST_PIPELINE_ID=

# --- MQTT (ESP32 relays, HA discovery) ---------------------------------------
MQTT_BROKER=homeassistant.local
MQTT_PORT=1883
MQTT_USER=replace-me
MQTT_PASS=replace-me
# wait for the device's state echo
MQTT_CONFIRM_ENABLED=true
MQTT_CONFIRM_TIMEOUT=3

# --- Wyoming bridge (Jarvis STT/TTS for Home Assistant Assist) ---------------
WYOMING_URI=tcp://0.0.0.0:10400
WYOMING_LANGUAGES=hr,en
JARVIS_TTS_URL=http://127.0.0.1:8000/api/tts

# --- Telegram ----------------------------------------------------------------
TELEGRAM_BOT_TOKEN=replace-me
# default delivery chat for scheduled jobs
TELEGRAM_CHAT_ID=replace-me
# comma-separated
TELEGRAM_AUTHORIZED_CHAT_IDS=replace-me

# --- Safety ------------------------------------------------------------------
APPROVAL_GATE_ENABLED=true
ENABLE_HITL=true
AUTO_APPROVE_HITL=false

# --- Research ----------------------------------------------------------------
# Raw search order; empty = jina,firecrawl,duckduckgo (custom_search is opt-in)
SEARCH_PROVIDERS=
# Page reading order; empty = firecrawl,jina,direct
SCRAPE_PROVIDERS=
JINA_API_KEY=
FIRECRAWL_API_KEY=
# Only used when SEARCH_PROVIDERS names custom_search
GOOGLE_CUSTOM_SEARCH_API_KEY=
GOOGLE_CUSTOM_SEARCH_CX=
SCRAPE_MAX_CHARS=12000

# --- Telegram receipt OCR ----------------------------------------------------
# Optional: tells the OCR which party on a bill is the household itself.
OCR_OWN_NAME=
OCR_OWN_TAX_ID=
