<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="hr.jarvis.launcher"
    android:versionCode="2"
    android:versionName="1.0">

    <uses-sdk android:minSdkVersion="21" android:targetSdkVersion="30" />

    <!-- Android TV must not reject the app for lacking touchscreen support. -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="true" />

    <!-- Android 11+ hides other packages from an app unless it declares what it
         wants to see. A <queries> intent filter was not enough here: A1 Xplore
         stayed invisible and getLaunchIntentForPackage returned null, so the
         launcher opened itself and sat there. Seeing every installed package IS
         this app's function, and it is sideloaded rather than published, so the
         Play Store policy around this permission does not apply. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
    </queries>

    <application
        android:label="Jarvis Launcher"
        android:allowBackup="false"
        android:banner="@android:drawable/ic_menu_send"
        android:icon="@android:drawable/ic_menu_send">

        <activity
            android:name=".LaunchActivity"
            android:exported="true"
            android:theme="@android:style/Theme.DeviceDefault"
            android:excludeFromRecents="true"
            android:noHistory="true">

            <!-- The whole reason this app exists: a URI the TV will resolve. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="jarvis" />
            </intent-filter>

            <!-- Visible in the TV's app list so it can be opened and checked. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
