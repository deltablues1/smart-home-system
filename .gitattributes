# Normalize line endings: LF in repo, native handling silenced.
# Stops the "LF will be replaced by CRLF" warning spam on Windows.
* text=auto

# Files that must keep LF (shell scripts run on RPi/Linux)
*.sh text eol=lf

# Binary files — never touch line endings
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.pdf binary
*.p12 binary
*.pfx binary
*.ico binary
*.woff binary
*.woff2 binary
*.zip binary
