# results). The *.example.json files next to them show the shape.
config/tv_apps.json
config/tv_channels.json
config/scheduled_jobs*.json
!config/*.example.json
data/*.json
data/dashboard-backups/
data/christian/build/
logs/
output/
uploads/
*.log
*.bak
*.bak_*

# --- Android TV launcher build outputs --------------------------------------
deploy/tv_app_launcher/build/
deploy/tv_app_launcher/*.jar
deploy/tv_app_launcher/*.keystore

# --- ESPHome build cache ----------------------------------------------------
esphome/.esphome/

